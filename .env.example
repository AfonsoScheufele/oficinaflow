POSTGRES_USER=oficinaflow
POSTGRES_PASSWORD=oficinaflow
POSTGRES_DB=oficinaflow

DATABASE_URL=postgresql+psycopg://oficinaflow:oficinaflow@localhost:5436/oficinaflow
REDIS_URL=redis://localhost:6383/0

JWT_SECRET=change-me-oficinaflow-dev-secret-32chars
JWT_EXPIRE_MINUTES=720
COOKIE_NAME=oficinaflow_token
COOKIE_SECURE=false

FRONTEND_ORIGIN=http://localhost:5175
API_PUBLIC_URL=http://localhost:8002

# Sem token = Pix demo. Com token = Mercado Pago sandbox.
MP_ACCESS_TOKEN=
WEBHOOK_DEMO_SECRET=demo-webhook-secret

# false = job RQ no mesmo processo (local). true = precisa de `make worker`.
RQ_ASYNC=false
WEBHOOK_MAX_RETRIES=2

# Limites plano free
FREE_MAX_STAFF=1
FREE_MAX_WORK_ORDERS_MONTH=20
PRO_MAX_STAFF=20
PRO_PRICE_CENTS=9900
